   "pseudocode": [
     "-- Write an audit trail record for the deletion",
     "SET ws_timestamp = <current_timestamp>  -- ACCEPT WS-TIMESTAMP FROM TIME STAMP: run-time value",
     "SET aud_timestamp = ws_timestamp",
     "SET aud_action = 'DELETE'",
     "SET aud_key = port_key",
     "SET aud_reason = del_reason_code  -- '01' closed, '02' transferred, '03' requested",
     "SET aud_status = port_status  -- status of the deleted portfolio: 'A' active, 'C' closed, 'S' suspended",
