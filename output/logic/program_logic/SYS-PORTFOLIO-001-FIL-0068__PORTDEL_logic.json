  {"name": "2100-PROCESS-DELETE", "section": null, "paragraph_id": "SYS-PORTFOLIO-001-FIL-0068-PAR-0004", "section_id": null, "line_range": [139, 155],
   "pseudocode": [
     "-- Look up the portfolio named in the deletion request",
     "SET port_key = del_key  -- request key (portfolio ID + account number) becomes the portfolio record key",
     "READ record from PORTFOLIO-FILE where key = port_key  -- random keyed read; no INVALID KEY clause, the outcome is tested through ws_file_status",
     "IF ws_file_status = '00' THEN  -- EVALUATE TRUE, WHEN WS-SUCCESS-STATUS: portfolio found",
     "  CALL 2200-delete-record",
     "ELSE IF ws_file_status = '23' THEN  -- WHEN WS-REC-NOT-FND: portfolio not found",
     "  INCREMENT ws_not_fnd_count BY 1",
     "  DISPLAY 'Record not found: ' port_key",
     "ELSE  -- WHEN OTHER: any other read status",
     "  INCREMENT ws_error_count BY 1",
     "  DISPLAY 'Read error for: ' port_key",
     "END IF"],
