      "-- Decide the recovery action from the error severity",
      "IF error severity is fatal THEN  -- ERR-FATAL: error.severity = 'F'",
      "  SET action = ABEND  -- ERR-ABEND: error.action = 'A'",
      "ELSE IF error severity is warning THEN  -- ERR-WARNING: severity = 'W'",
      "  SET action = CONTINUE  -- ERR-CONTINUE: error.action = 'C'",
      "ELSE IF error severity is informational THEN  -- ERR-INFO: severity = 'I'",
      "  SET action = CONTINUE  -- ERR-CONTINUE: error.action = 'C'",
      "ELSE",
      "  SET action = RETURN  -- ERR-RETURN: error.action = 'R'",
      "END IF",
      "SET dfhcommarea = ws_error_area  -- pass the updated error area back to the caller"
    ],
