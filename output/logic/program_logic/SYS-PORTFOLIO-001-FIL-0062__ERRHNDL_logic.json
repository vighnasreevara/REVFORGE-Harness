    "line_range": [104, 116],
    "pseudocode": [
      "IF err_severity = 'F' THEN  -- ERR-FATAL (EVALUATE TRUE, first matching WHEN wins)",
      "  SET err_action = 'A'  -- SET ERR-ABEND TO TRUE: caller should abend",
      "ELSE IF err_severity = 'W' THEN  -- ERR-WARNING",
      "  SET err_action = 'C'  -- SET ERR-CONTINUE TO TRUE: caller may continue",
      "ELSE IF err_severity = 'I' THEN  -- ERR-INFO",
      "  SET err_action = 'C'  -- SET ERR-CONTINUE TO TRUE",
      "ELSE  -- WHEN OTHER",
      "  SET err_action = 'R'  -- SET ERR-RETURN TO TRUE: caller should return",
      "END IF",
      "SET dfhcommarea = ws_error_area  -- copy the updated error block back to the caller's COMMAREA",
      "-- Falls through to P400-EXIT (end of the PERFORM THRU range)"
    ],
