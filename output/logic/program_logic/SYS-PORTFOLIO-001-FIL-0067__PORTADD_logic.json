  {"name": "2100-VALIDATE-AND-ADD", "section": null, "paragraph_id": "SYS-PORTFOLIO-001-FIL-0067-PAR-0004", "section_id": null, "line_range": [113, 138],
   "pseudocode": [
     "-- Validate the input record and add it to the portfolio master",
     "IF port_id is blank OR client_name is blank OR portfolio_status != 'A' THEN  -- 'A' = active",
     "  INCREMENT error_count BY 1",
     "  DISPLAY 'Invalid record data: ' port_id",
     "  EXIT paragraph  -- EXIT PARAGRAPH: skip the rest of this paragraph  !! unstructured early exit",
     "END IF",
     "SET portfolio_create_date = ws_current_date",
     "SET portfolio_last_maint_date = ws_current_date",
     "WRITE port_record to PORTFOLIO-FILE  -- keyed by PORT-KEY; no INVALID KEY clause, outcome checked by file status  !! REVIEW: unqualified PORT-RECORD",
     "IF portfolio file status = '00' THEN  -- EVALUATE TRUE",
     "  INCREMENT add_count BY 1",
     "ELSE IF portfolio file status = '22' THEN  -- duplicate key",
     "  INCREMENT dup_count BY 1",
     "  DISPLAY 'Duplicate record: ' port_id",
     "ELSE",
     "  INCREMENT error_count BY 1",
     "  DISPLAY 'Write error for: ' port_id",
     "END IF"
   ],
