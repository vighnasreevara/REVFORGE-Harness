    "pseudocode": [
      "CICS ASSIGN USERID → ws_user_id  -- obtain the signed-on CICS user ID",
      "  RESPONSE CODE → sec_response_code",
      "IF sec_response_code = NORMAL THEN  -- DFHRESP(NORMAL)",
      "  IF sec_user_id = ws_user_id THEN  -- requested user matches the signed-on user",
      "    SET sec_response_code = 0",
      "  ELSE",
      "    SET sec_error_info = 'User validation failed'",
      "    SET sec_response_code = 8",
      "  END IF",
      "ELSE",
      "  SET sec_error_info = 'Unable to obtain user credentials'",
      "  SET sec_response_code = 12",
      "END IF"
    ],
