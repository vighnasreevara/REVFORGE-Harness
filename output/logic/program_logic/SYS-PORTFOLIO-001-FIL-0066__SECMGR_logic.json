     "-- Write a security audit record for this access to DB2 table AUDITLOG",
     "SET timestamp (WS-TIMESTAMP) = FUNCTION CURRENT-DATE  -- runtime value: system date and time",
     "CICS ASSIGN: get user ID INTO WS-USER-ID, terminal ID INTO WS-TERMINAL-ID, transaction ID INTO WS-TRANSACTION-ID  -- no RESP option",
