     "IF SQLCODE = 0 THEN",
     "  SET response_code (SEC-RESPONSE-CODE) = 0  -- audit row written",
     "ELSE",
     "  SET error_info (SEC-ERROR-INFO) = 'Audit logging failed'",
     "  SET response_code (SEC-RESPONSE-CODE) = 12",
     "END IF"
