      "IF request type is validate (SEC-REQUEST-TYPE = 'V') THEN",
      "  CALL p100-validate-user THRU p100-exit  !! PERFORM THRU",
      "ELSE IF request type is authorize (SEC-REQUEST-TYPE = 'A') THEN",
      "  CALL p200-check-auth THRU p200-exit  !! PERFORM THRU",
      "ELSE IF request type is audit log (SEC-REQUEST-TYPE = 'L') THEN",
      "  CALL p300-log-access THRU p300-exit  !! PERFORM THRU",
      "END IF  -- no WHEN OTHER: any other request type does nothing",
      "CICS RETURN TO caller"
    ],
