      "ELSE IF cursor_request_type = 'O' THEN  -- CURS-OPEN",
      "  CALL P200-open-cursor THRU P200-exit  !! PERFORM THRU: runs P200-OPEN-CURSOR then P200-EXIT in sequence",
      "ELSE IF cursor_request_type = 'F' THEN  -- CURS-FETCH",
      "  CALL P300-fetch-data THRU P300-exit  !! PERFORM THRU -- UNRESOLVED: neither paragraph exists in the source (file truncated at line 91)",
      "ELSE IF cursor_request_type = 'C' THEN  -- CURS-CLOSE",
      "  CALL P400-close-cursor THRU P400-exit  !! PERFORM THRU -- UNRESOLVED: neither paragraph exists in the source (file truncated at line 91)",
      "END IF  -- no WHEN OTHER: any other request type performs nothing",
      "CICS RETURN TO caller"
