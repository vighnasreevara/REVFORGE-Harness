   "pseudocode": [
     "-- Summarise the logged return codes of one program within a time window",
     "SQL SELECT COUNT(*), MAX(RETURN_CODE), MIN(RETURN_CODE)",
     "  FROM: RTNCODES table",
     "  WHERE: PROGRAM_ID = program_id (RC-PROGRAM-ID) AND TIMESTAMP >= start_time (RC-START-TIME) AND TIMESTAMP <= end_time (RC-END-TIME)",
