   "pseudocode": [
     "-- Write an audit row for the current return code to DB2 table RTNCODES",
     "SET current_time (WS-CURRENT-TIME) = FUNCTION CURRENT-DATE  -- runtime value: system date and time",
     "SQL INSERT new row INTO RTNCODES table",
     "  COLUMNS: TIMESTAMP, PROGRAM_ID, RETURN_CODE, HIGHEST_CODE, STATUS_CODE, MESSAGE_TEXT",
     "  VALUES: current_time (WS-CURRENT-TIME), program_id (RC-PROGRAM-ID), current_code (RC-CURRENT-CODE), highest_code (RC-HIGHEST-CODE), status (RC-STATUS), message (RC-MESSAGE)",
     "CHECK SQLCODE for errors",
     "IF SQLCODE = 0 THEN",
     "  SET response_code (RC-RESPONSE-CODE) = 0  -- row inserted",
     "ELSE",
     "  SET response_code (RC-RESPONSE-CODE) = 8  -- insert failed",
     "END IF"
