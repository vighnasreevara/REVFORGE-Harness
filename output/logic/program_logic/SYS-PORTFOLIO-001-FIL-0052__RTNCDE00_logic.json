     "  CALL P500-analyze-codes THRU P500-exit  !! PERFORM THRU: runs paragraph range P500-ANALYZE-CODES .. P500-EXIT",
     "END IF  -- no WHEN OTHER: any other request type performs nothing",
     "RETURN to caller  -- GOBACK"
