      "  CALL P100-process-connect THRU P100-exit  !! PERFORM THRU: runs P100-PROCESS-CONNECT then P100-EXIT in sequence",
      "ELSE IF db2_request_type = 'D' THEN  -- DB2-DISCONNECT",
      "  CALL P200-process-disconnect THRU P200-exit  !! PERFORM THRU: runs P200-PROCESS-DISCONNECT then P200-EXIT in sequence",
      "ELSE IF db2_request_type = 'S' THEN  -- DB2-STATUS",
      "  CALL P300-check-status THRU P300-exit  !! PERFORM THRU: runs P300-CHECK-STATUS then P300-EXIT in sequence",
      "END IF  -- no WHEN OTHER: any other request type performs nothing",
      "CICS RETURN TO caller"
    ],
