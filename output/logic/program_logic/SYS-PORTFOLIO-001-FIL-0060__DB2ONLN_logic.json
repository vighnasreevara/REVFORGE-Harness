   "pseudocode": [
     "-- Entry point: dispatch on the DB2 request type supplied in DB2-REQUEST-AREA",
     "IF request is Connect (DB2-CONNECT: DB2-REQUEST-TYPE = 'C') THEN",
     "  CALL P100-process-connect THRU P100-exit  !! PERFORM THRU: runs paragraph range P100-PROCESS-CONNECT .. P100-EXIT",
     "ELSE IF request is Disconnect (DB2-DISCONNECT: DB2-REQUEST-TYPE = 'D') THEN",
     "  CALL P200-process-disconnect THRU P200-exit  !! PERFORM THRU: runs paragraph range P200-PROCESS-DISCONNECT .. P200-EXIT",
     "ELSE IF request is Status (DB2-STATUS: DB2-REQUEST-TYPE = 'S') THEN",
     "  CALL P300-check-status THRU P300-exit  !! PERFORM THRU: runs paragraph range P300-CHECK-STATUS .. P300-EXIT",
     "END IF  -- no WHEN OTHER: any other request type performs nothing",
     "CICS RETURN TO caller  -- EXEC CICS RETURN"
   ],
