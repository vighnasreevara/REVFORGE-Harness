      "CALL 1000-initialize",
      "WHILE NOT end_of_file DO  -- PERFORM 2000-PROCESS UNTIL END-OF-FILE: condition tested before each iteration",
      "  CALL 2000-process",
      "END WHILE",
      "CALL 3000-terminate",
      "RETURN to caller  -- GOBACK: ends the run (main program)"
