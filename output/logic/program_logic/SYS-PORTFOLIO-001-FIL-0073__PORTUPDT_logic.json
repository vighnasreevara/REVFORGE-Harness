  {"name": "2200-APPLY-UPDATE", "section": null, "paragraph_id": "SYS-PORTFOLIO-001-FIL-0073-PAR-0005", "section_id": null, "line_range": [131, 151],
   "pseudocode": [
     "-- Apply the requested change to the master record and rewrite it",
     "IF update action = 'S' (UPDT-STATUS) THEN  -- EVALUATE TRUE, no WHEN OTHER",
     "  SET portfolio_status = updt_new_value",
     "ELSE IF update action = 'N' (UPDT-NAME) THEN",
     "  SET client_name = updt_new_value",
     "ELSE IF update action = 'V' (UPDT-VALUE) THEN",
     "  SET ws_numeric_work = updt_new_value  -- alphanumeric text moved into a signed numeric field (13 integer, 2 decimal digits)",
     "  SET portfolio_total_value = ws_numeric_work  -- stored as packed decimal",
     "END IF  -- any other action code changes nothing",
     "UPDATE existing port_record in PORTFOLIO-FILE  -- REWRITE",
     "IF portfolio file status = '00' THEN",
     "  INCREMENT update_count BY 1",
     "ELSE",
     "  INCREMENT error_count BY 1",
     "  DISPLAY 'Update failed for: ' port_key",
     "END IF"
   ],
