     "CHECK SQLCODE",
     "IF sqlcode = 0 THEN",
     "  WRITE ws_detail_line to REPORT-FILE",
     "  COMPUTE ws_program_count = ws_program_count + ws_dtl_total",
     "  COMPUTE ws_success_count = ws_success_count + ws_dtl_success",
     "  COMPUTE ws_warning_count = ws_warning_count + ws_dtl_warning",
     "  COMPUTE ws_error_count = ws_error_count + ws_dtl_error",
     "  COMPUTE ws_severe_count = ws_severe_count + ws_dtl_severe",
     "END IF  -- no ELSE: end of data (100) or an error simply skips the line"
