    "pseudocode": [
      "DECLARE SQL CURSOR prgcur FOR",
      "  SQL SELECT program_id, COUNT(*) AS total, COUNT(status_code = 'S'), COUNT(status_code = 'W'), COUNT(status_code = 'E'), COUNT(status_code = 'F')",
