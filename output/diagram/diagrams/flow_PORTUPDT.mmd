  DEC_ACTION -->|when 'S'| UPD_STATUS
  DEC_ACTION -->|when 'N'| UPD_NAME
  DEC_ACTION -->|when 'V'| UPD_VALUE
  DEC_ACTION -->|no match| IO_REWRITE
  UPD_STATUS --> IO_REWRITE
  UPD_NAME --> IO_REWRITE
  UPD_VALUE --> IO_REWRITE
  IO_REWRITE --> DEC_REWRITE
  DEC_REWRITE -->|yes — count update| LOOP_CHECK
  DEC_REWRITE -->|no — count error, display| LOOP_CHECK
  PARA_3000 --> TERMINAL

