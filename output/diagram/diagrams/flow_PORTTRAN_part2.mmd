  %% Generated by 6_diagram agent — sequence-builder skill
  %% Program: PORTTRAN — detail of 2110, 2120 and 2130; continued from flow_PORTTRAN.mmd
  %% Edges: solid = confirmed; -.-> runtime:/uncertain: = uncertain; -.-> ? = unsupported

  classDef rule     fill:#ede9fe,stroke:#7c3aed,color:#2e1065
  classDef io       fill:#fef3c7,stroke:#f59e0b,color:#451a03
  classDef runtime  fill:#fff7ed,stroke:#ea580c,color:#431407,stroke-dasharray:4 4

  ENTRY(["Validate transaction — error text cleared"])

  PARA_2110["Check portfolio"]
  RULE_BR072("⚖ BR-072: Require portfolio ID on a transaction"):::rule
  DEC_PID{"Portfolio ID blank?"}
  ERR_PID["Error: portfolio ID is required"]
  IO_PREAD[/"Read portfolio record by ID"/]:::io
  ERR_PNF["Error: invalid portfolio ID"]

  PARA_2120["Check transaction type"]
  RULE_BR074("⚖ BR-074: Type is buy, sell, transfer or fee"):::rule
  DEC_TTYPE{"Transaction type?"}
  ERR_TYPE["Error: invalid transaction type"]

  PARA_2130["Check amounts"]
  RULE_BR075("⚖ BR-075: Quantity greater than zero"):::rule
  DEC_QTY{"Quantity zero or less?"}
  RULE_BR076("⚖ BR-076: Price above zero except transfers"):::rule
  DEC_PRICE{"Price zero or less, not a transfer?"}
  RULE_BR077("⚖ BR-077: Amount above zero except transfers"):::rule
  DEC_AMT{"Amount zero or less, not a transfer?"}
  ERR_AMT["Error: quantity, price or amount invalid"]

  RETURN_2100(["Back to 2100 error check — see overview"])

  ENTRY --> PARA_2110
  PARA_2110 --> RULE_BR072
  RULE_BR072 --> DEC_PID
  DEC_PID -->|yes / true| ERR_PID
  ERR_PID -->|exit paragraph| RETURN_2100
  DEC_PID -->|no / false| IO_PREAD
  IO_PREAD -.->|uncertain: not found| ERR_PNF
  IO_PREAD -.->|uncertain: found| RETURN_2100
  ERR_PNF --> RETURN_2100

  ENTRY -->|when no error so far| PARA_2120
  PARA_2120 --> RULE_BR074
  RULE_BR074 --> DEC_TTYPE
  DEC_TTYPE -->|when 'BU', 'SL', 'TR', 'FE'| RETURN_2100
  DEC_TTYPE -->|other| ERR_TYPE
  ERR_TYPE --> RETURN_2100

  ENTRY -->|when no error so far| PARA_2130
  PARA_2130 --> RULE_BR075
  RULE_BR075 --> DEC_QTY
  DEC_QTY -->|yes / true — exit paragraph| ERR_AMT
  DEC_QTY -->|no / false| RULE_BR076
  RULE_BR076 --> DEC_PRICE
  DEC_PRICE -->|yes / true — exit paragraph| ERR_AMT
  DEC_PRICE -->|no / false| RULE_BR077
  RULE_BR077 --> DEC_AMT
  DEC_AMT -->|yes / true| ERR_AMT
  DEC_AMT -->|no / false| RETURN_2100
  ERR_AMT --> RETURN_2100

