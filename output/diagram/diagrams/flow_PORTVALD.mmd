  START(["Start — called with a validation request"])
  PARA_0000["Main control: clear work areas"]
  RULE_BR083("⚖ BR-083: Route validation requests by type"):::rule
  DEC_TYPE{"Validation type?"}

  PARA_1000["Validate ID"]
  RULE_BR084("⚖ BR-084: Portfolio ID starts with PORT"):::rule
  DEC_PREFIX{"ID prefix is not PORT?"}
  RULE_BR085("⚖ BR-085: ID number part is numeric · SME review"):::rule
  DEC_IDNUM{"ID digits not numeric?"}

  PARA_2000["Validate account"]
  RULE_BR086("⚖ BR-086: Account numeric and not zero"):::rule
  DEC_ACCT{"Account not numeric or zero?"}

  PARA_3000["Validate type"]
  RULE_BR087("⚖ BR-087: Investment type is valid"):::rule
  DEC_ITYPE{"Not STK, BND, MMF or ETF?"}

  PARA_4000["Validate amount"]
  RULE_BR088("⚖ BR-088: Amount within min and max · SME review"):::rule
  DEC_AMT{"Amount out of range?"}

  TERMINAL(["Return to caller — GOBACK"]):::terminal

  START --> PARA_0000
  PARA_0000 --> RULE_BR083
  RULE_BR083 --> DEC_TYPE
  DEC_TYPE -->|when 'I' — portfolio ID| PARA_1000
  DEC_TYPE -->|when 'A' — account| PARA_2000
  DEC_TYPE -->|when 'T' — investment type| PARA_3000
  DEC_TYPE -->|when 'M' — amount| PARA_4000
  DEC_TYPE -->|other — code 1, invalid validation type| TERMINAL

  PARA_1000 --> RULE_BR084
  RULE_BR084 --> DEC_PREFIX
  DEC_PREFIX -->|yes / true — invalid ID, code 1| TERMINAL
  DEC_PREFIX -->|no / false| RULE_BR085
  RULE_BR085 --> DEC_IDNUM
  DEC_IDNUM -->|yes / true — invalid ID, code 1| TERMINAL
  DEC_IDNUM -->|no / false — success, code 0| TERMINAL

  PARA_2000 --> RULE_BR086
  RULE_BR086 --> DEC_ACCT
  DEC_ACCT -->|yes / true — invalid account, code 2| TERMINAL
  DEC_ACCT -->|no / false — success, code 0| TERMINAL

  PARA_3000 --> RULE_BR087
  RULE_BR087 --> DEC_ITYPE
  DEC_ITYPE -->|yes / true — invalid type, code 3| TERMINAL
  DEC_ITYPE -->|no / false — success, code 0| TERMINAL

  PARA_4000 --> RULE_BR088
  RULE_BR088 --> DEC_AMT
  DEC_AMT -->|yes / true — invalid amount, code 4| TERMINAL
  DEC_AMT -->|no / false — success, code 0| TERMINAL

