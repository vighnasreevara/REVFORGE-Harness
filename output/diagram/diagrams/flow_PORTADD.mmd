  START(["Start — batch job runs PORTADD"])
  PARA_0000["Main control"]
  PARA_1000["Initialize"]
  IO_OPEN[/"Open portfolio file and input file"/]:::io
  DEC_OPEN{"Either file failed to open?"}

  subgraph LOOP_0000["Loop: for each input record until end of file"]
    LOOP_CHECK{{"End of input file?"}}:::loop
    PARA_2000["Process"]
    IO_READ[/"Read next input record"/]:::io
    PARA_2100["Validate and add"]
    RULE_BR063("⚖ BR-063: Require ID, name and active status"):::rule
    DEC_VALID{"ID or client name blank, or not active?"}
    ERR_INVALID["Count error, display, skip record"]
    IO_WRITE[/"Stamp dates, write portfolio record"/]:::io
    DEC_WRITE{"Write status?"}
    ADD_OK["Count record added"]
    DUP["Count duplicate, display it"]
    WERR["Count write error, display it"]
  end

  PARA_3000["Terminate: close files, display counts"]
  TERMINAL(["End — GOBACK with return code"]):::terminal

  START --> PARA_0000
  PARA_0000 --> PARA_1000
  PARA_1000 --> IO_OPEN
  IO_OPEN --> DEC_OPEN
  DEC_OPEN -->|yes / true — error, return code 8| PARA_3000
  DEC_OPEN -->|no / false| LOOP_CHECK
  PARA_3000 -->|after early close on open failure| LOOP_CHECK
  LOOP_CHECK -->|no — continue| PARA_2000
  PARA_2000 --> IO_READ
  IO_READ -->|at end — set end-of-file flag| LOOP_CHECK
  IO_READ -->|record read| PARA_2100
  PARA_2100 --> RULE_BR063
  RULE_BR063 --> DEC_VALID
  DEC_VALID -->|yes / true| ERR_INVALID
  ERR_INVALID -->|repeat| LOOP_CHECK
  DEC_VALID -->|no / false| IO_WRITE
  IO_WRITE --> DEC_WRITE
  DEC_WRITE -->|when '00' added| ADD_OK
  DEC_WRITE -->|when '22' duplicate| DUP
  DEC_WRITE -->|other| WERR
  ADD_OK -->|repeat| LOOP_CHECK
  DUP -->|repeat| LOOP_CHECK
  WERR -->|repeat| LOOP_CHECK
  LOOP_CHECK -->|yes — done| PARA_3000
  PARA_3000 -->|normal end| TERMINAL

