{
  "mcpServers": {
    "neo4j": {
      "type": "stdio",
      "command": "mcp-neo4j-cypher",
      "env": {
        "NEO4J_URI": "neo4j+s://<your-instance>.databases.neo4j.io",
        "NEO4J_USERNAME": "<username>",
        "NEO4J_PASSWORD": "<password>",
        "NEO4J_DATABASE": "neo4j"
      }
    }
  }
}
