{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/bmad/scope-reconciliation.schema.json",
  "title": "Explained composition of one scope (direct, dependency, cross-scope and global items)",
  "type": "object",
  "properties": {
    "contract": {
      "const": "bmad/scope-reconciliation"
    },
    "contract_version": {
      "const": "1.0"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "scope_sha256": {
      "$ref": "../common.schema.json#/definitions/sha256"
    },
    "baseline": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "$ref": "../common.schema.json#/definitions/sha256"
        }
      },
      "required": [
        "run_id",
        "manifest_sha256"
      ],
      "additionalProperties": false
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit_kind": {
            "type": "string",
            "minLength": 1
          },
          "file_id": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "primary",
              "direct_dependency",
              "transitive_dependency"
            ]
          },
          "needed_by": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "via": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_sha256": {
            "anyOf": [
              {
                "$ref": "../common.schema.json#/definitions/sha256"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "unit_kind",
          "file_id",
          "relation",
          "needed_by",
          "via",
          "source_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "inclusion",
          "reason"
        ]
      }
    },
    "runtime_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "inclusion",
          "reason"
        ]
      }
    },
    "data_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "inclusion",
          "reason"
        ]
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "class",
          "reason",
          "effective_blocking"
        ],
        "properties": {
          "class": {
            "enum": [
              "direct",
              "shared_dependency",
              "cross_scope",
              "global"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "excluded": {
      "type": "object"
    },
    "unique_ids": {
      "type": "object",
      "properties": {
        "duplicates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "duplicates",
        "ok"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object"
    },
    "reconciliation_sha256": {
      "$ref": "../common.schema.json#/definitions/sha256"
    }
  },
  "required": [
    "contract",
    "contract_version",
    "scope",
    "scope_sha256",
    "baseline",
    "units",
    "requirements",
    "runtime_requirements",
    "data_contracts",
    "rules",
    "decisions",
    "excluded",
    "unique_ids",
    "summary",
    "reconciliation_sha256"
  ],
  "additionalProperties": false
}
