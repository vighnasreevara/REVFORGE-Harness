{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/bmad/output-review.schema.json",
  "title": "Normalised BMad code-review result (recommendation only)",
  "type": "object",
  "properties": {
    "contract": {
      "const": "bmad/output-review"
    },
    "contract_version": {
      "const": "1.0"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^BPK-[0-9]{4}$"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^BMAD-[A-Z]+$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^bmad-[a-z0-9-]+$"
    },
    "agent": {
      "enum": [
        "F1",
        "F2",
        "F3",
        "F4",
        "F5",
        "F6",
        "F7"
      ]
    },
    "mode": {
      "enum": [
        "MOCK",
        "LIVE"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "scope_sha256": {
      "$ref": "../common.schema.json#/definitions/sha256"
    },
    "baseline_manifest_sha256": {
      "$ref": "../common.schema.json#/definitions/sha256"
    },
    "produced_by": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "mock"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "produced_at": {
      "$ref": "../common.schema.json#/definitions/isoTimestamp"
    },
    "status": {
      "enum": [
        "recommendation"
      ]
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "../common.schema.json#/definitions/sha256"
          },
          "kind": {
            "enum": [
              "markdown",
              "json",
              "yaml",
              "java",
              "build",
              "log"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "implementation_receipt": {
      "type": "string",
      "minLength": 1
    },
    "independent_test_receipt": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "../common.schema.json#/definitions/sha256"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "finding_id",
          "severity",
          "file",
          "line",
          "description",
          "requirement_ids"
        ],
        "additionalProperties": false
      }
    },
    "recommendation": {
      "enum": [
        "recommend_accept",
        "recommend_changes",
        "recommend_reject"
      ]
    }
  },
  "required": [
    "contract",
    "contract_version",
    "packet_id",
    "binding_id",
    "workflow_id",
    "agent",
    "mode",
    "scope",
    "scope_sha256",
    "baseline_manifest_sha256",
    "produced_by",
    "produced_at",
    "status",
    "documents",
    "implementation_receipt",
    "independent_test_receipt",
    "reviewed_files",
    "findings",
    "recommendation"
  ],
  "additionalProperties": false
}
