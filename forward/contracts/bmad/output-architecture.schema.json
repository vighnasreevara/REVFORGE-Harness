{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/bmad/output-architecture.schema.json",
  "title": "Normalised BMad architecture result (draft for G3)",
  "type": "object",
  "properties": {
    "contract": {
      "const": "bmad/output-architecture"
    },
    "contract_version": {
      "const": "1.0"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^BPK-[0-9]{4}$"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^BMAD-[A-Z]+$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^bmad-[a-z0-9-]+$"
    },
    "agent": {
      "enum": [
        "F1",
        "F2",
        "F3",
        "F4",
        "F5",
        "F6",
        "F7"
      ]
    },
    "mode": {
      "enum": [
        "MOCK",
        "LIVE"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "scope_sha256": {
      "$ref": "../common.schema.json#/definitions/sha256"
    },
    "baseline_manifest_sha256": {
      "$ref": "../common.schema.json#/definitions/sha256"
    },
    "produced_by": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "mock"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "produced_at": {
      "$ref": "../common.schema.json#/definitions/isoTimestamp"
    },
    "status": {
      "enum": [
        "draft"
      ]
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "../common.schema.json#/definitions/sha256"
          },
          "kind": {
            "enum": [
              "markdown",
              "json",
              "yaml",
              "java",
              "build",
              "log"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "adr_id": {
            "type": "string",
            "pattern": "^ADR-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "adr_id",
          "title",
          "decision",
          "rationale",
          "requirement_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "cobol_units": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "component_id",
          "name",
          "responsibility",
          "requirement_ids",
          "cobol_units"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "contract",
    "contract_version",
    "packet_id",
    "binding_id",
    "workflow_id",
    "agent",
    "mode",
    "scope",
    "scope_sha256",
    "baseline_manifest_sha256",
    "produced_by",
    "produced_at",
    "status",
    "documents",
    "decisions",
    "components"
  ],
  "additionalProperties": false
}
