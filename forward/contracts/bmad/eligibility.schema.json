{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/bmad/eligibility.schema.json",
  "title": "Eligibility of one BMad workflow for one exact scope",
  "type": "object",
  "properties": {
    "contract": {
      "const": "bmad/eligibility"
    },
    "contract_version": {
      "const": "1.0"
    },
    "evaluated_at": {
      "$ref": "../common.schema.json#/definitions/isoTimestamp"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^BMAD-[A-Z]+$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^bmad-[a-z0-9-]+$"
    },
    "agent": {
      "enum": [
        "F1",
        "F2",
        "F3",
        "F4",
        "F5",
        "F6",
        "F7"
      ]
    },
    "mode": {
      "enum": [
        "DISCOVERY",
        "DRY_RUN",
        "MOCK",
        "LIVE"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "scope_sha256": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/definitions/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "baseline": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "$ref": "../common.schema.json#/definitions/sha256"
        }
      },
      "required": [
        "run_id",
        "manifest_sha256"
      ],
      "additionalProperties": false
    },
    "workflow_state": {
      "type": "string",
      "minLength": 1
    },
    "eligible": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ok": {
            "type": "boolean"
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "ok",
          "detail"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "contract",
    "contract_version",
    "evaluated_at",
    "binding_id",
    "workflow_id",
    "agent",
    "mode",
    "scope",
    "scope_sha256",
    "baseline",
    "workflow_state",
    "eligible",
    "checks",
    "reasons"
  ]
}
