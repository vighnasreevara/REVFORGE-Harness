{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/bmad/output-epics.schema.json",
  "title": "Normalised BMad epics and stories result (drafts until G4)",
  "type": "object",
  "properties": {
    "contract": {
      "const": "bmad/output-epics"
    },
    "contract_version": {
      "const": "1.0"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^BPK-[0-9]{4}$"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^BMAD-[A-Z]+$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^bmad-[a-z0-9-]+$"
    },
    "agent": {
      "enum": [
        "F1",
        "F2",
        "F3",
        "F4",
        "F5",
        "F6",
        "F7"
      ]
    },
    "mode": {
      "enum": [
        "MOCK",
        "LIVE"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "scope_sha256": {
      "$ref": "../common.schema.json#/definitions/sha256"
    },
    "baseline_manifest_sha256": {
      "$ref": "../common.schema.json#/definitions/sha256"
    },
    "produced_by": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "mock"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "produced_at": {
      "$ref": "../common.schema.json#/definitions/isoTimestamp"
    },
    "status": {
      "enum": [
        "draft"
      ]
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "../common.schema.json#/definitions/sha256"
          },
          "kind": {
            "enum": [
              "markdown",
              "json",
              "yaml",
              "java",
              "build",
              "log"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "epics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "epic_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "stories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "story_id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "requirement_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "architecture_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "acceptance_criteria": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ac_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "ac_id",
                      "text"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                },
                "status": {
                  "const": "draft"
                }
              },
              "required": [
                "story_id",
                "title",
                "requirement_ids",
                "architecture_refs",
                "acceptance_criteria",
                "status"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "epic_id",
          "title",
          "requirement_ids",
          "stories"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "contract",
    "contract_version",
    "packet_id",
    "binding_id",
    "workflow_id",
    "agent",
    "mode",
    "scope",
    "scope_sha256",
    "baseline_manifest_sha256",
    "produced_by",
    "produced_at",
    "status",
    "documents",
    "epics"
  ],
  "additionalProperties": false
}
