{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/bmad/execution-manifest.schema.json",
  "title": "BMad LIVE execution manifest (what the executor would run, with every precondition)",
  "type": "object",
  "properties": {
    "contract": {
      "const": "bmad/execution-manifest"
    },
    "contract_version": {
      "const": "1.0"
    },
    "prepared_at": {
      "$ref": "../common.schema.json#/definitions/isoTimestamp"
    },
    "mode": {
      "enum": [
        "DRY_RUN",
        "LIVE"
      ]
    },
    "binding_id": {
      "type": "string",
      "pattern": "^BMAD-[A-Z]+$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^bmad-[a-z0-9-]+$"
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "scope_sha256": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/definitions/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "release": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "directory_sha256": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/definitions/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "package",
        "version",
        "directory_sha256"
      ],
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "isolated": {
          "type": "boolean"
        },
        "home": {
          "type": "string",
          "minLength": 1
        },
        "claude_dir": {
          "type": "string",
          "minLength": 1
        },
        "installed_skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "installation_record": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "isolated",
        "home",
        "claude_dir",
        "installed_skills",
        "installation_record"
      ],
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "data_disclosure": {
          "type": "string",
          "minLength": 1
        },
        "authorization_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "runner",
        "data_disclosure",
        "authorization_id"
      ],
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "properties": {
        "program": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "env_allowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "program",
        "args",
        "cwd",
        "env_allowlist"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "../common.schema.json#/definitions/sha256"
          }
        },
        "required": [
          "name",
          "path",
          "sha256"
        ]
      }
    },
    "output_dir": {
      "type": [
        "string",
        "null"
      ]
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ok": {
            "type": "boolean"
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "ok",
          "detail"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "executable": {
      "type": "boolean"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "contract",
    "contract_version",
    "prepared_at",
    "mode",
    "binding_id",
    "workflow_id",
    "agent",
    "scope",
    "scope_sha256",
    "release",
    "workspace",
    "provider",
    "command",
    "inputs",
    "output_dir",
    "preconditions",
    "executable",
    "blockers"
  ],
  "additionalProperties": false
}
