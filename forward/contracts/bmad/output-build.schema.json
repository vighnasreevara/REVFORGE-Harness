{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/bmad/output-build.schema.json",
  "title": "Normalised BMad build result (Java confined to the authorised target)",
  "type": "object",
  "properties": {
    "contract": {
      "const": "bmad/output-build"
    },
    "contract_version": {
      "const": "1.0"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^BPK-[0-9]{4}$"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^BMAD-[A-Z]+$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^bmad-[a-z0-9-]+$"
    },
    "agent": {
      "enum": [
        "F1",
        "F2",
        "F3",
        "F4",
        "F5",
        "F6",
        "F7"
      ]
    },
    "mode": {
      "enum": [
        "MOCK",
        "LIVE"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "scope_sha256": {
      "$ref": "../common.schema.json#/definitions/sha256"
    },
    "baseline_manifest_sha256": {
      "$ref": "../common.schema.json#/definitions/sha256"
    },
    "produced_by": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "mock"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "produced_at": {
      "$ref": "../common.schema.json#/definitions/isoTimestamp"
    },
    "status": {
      "enum": [
        "built",
        "failed"
      ]
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "../common.schema.json#/definitions/sha256"
          },
          "kind": {
            "enum": [
              "markdown",
              "json",
              "yaml",
              "java",
              "build",
              "log"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "story_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "../common.schema.json#/definitions/sha256"
          },
          "story_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "path",
          "sha256",
          "story_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "build": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer"
        },
        "log_sha256": {
          "$ref": "../common.schema.json#/definitions/sha256"
        }
      },
      "required": [
        "tool",
        "command",
        "exit_code",
        "log_sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract",
    "contract_version",
    "packet_id",
    "binding_id",
    "workflow_id",
    "agent",
    "mode",
    "scope",
    "scope_sha256",
    "baseline_manifest_sha256",
    "produced_by",
    "produced_at",
    "status",
    "documents",
    "story_ids",
    "files",
    "build"
  ],
  "additionalProperties": false
}
