{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/output/decision-backlog.schema.json",
  "title": "Initial unresolved-decision backlog",
  "allOf": [{ "$ref": "../common.schema.json#/definitions/outputHeader" }],
  "type": "object",
  "required": ["contract", "counts", "decisions"],
  "properties": {
    "contract": { "const": "decision-backlog" },
    "counts": { "type": "object", "required": ["total", "blocking", "by_kind"] },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision_id", "kind", "severity", "blocking", "status", "question", "programs", "file_ids", "refs"],
        "properties": {
          "decision_id": { "$ref": "../common.schema.json#/definitions/decisionId" },
          "kind": { "enum": ["source_access", "gap_resolution", "rule_confirmation", "assumption_confirmation", "selection"] },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "blocking": { "type": "boolean" },
          "status": { "const": "open" },
          "question": { "type": "string", "minLength": 1 },
          "file_ids": { "type": "array", "items": { "$ref": "../common.schema.json#/definitions/fileId" } },
          "refs": { "type": "array", "items": { "$ref": "../common.schema.json#/definitions/runLocalRef" } }
        }
      }
    }
  }
}
