{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/demo/architecture.schema.json",
  "title": "Synthetic demo architecture",
  "description": "Java architecture of the synthetic demo program, bound to the exact requirements it designs for (demo gate G3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "environment",
    "program_id",
    "requirements_ref",
    "data_contract_ref",
    "target",
    "components",
    "dependencies",
    "decisions"
  ],
  "properties": {
    "contract": {
      "const": "demo/architecture"
    },
    "contract_version": {
      "const": "1.0"
    },
    "environment": {
      "const": "SYNTHETIC_INTERVIEW_DEMO"
    },
    "program_id": {
      "type": "string",
      "minLength": 1
    },
    "authored_by": {
      "type": "string",
      "minLength": 1
    },
    "requirements_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "data_contract_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "build",
        "generation"
      ],
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_id",
          "name",
          "kind",
          "responsibility",
          "requirement_ids"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "pattern": "^CMP-DEMO-[0-9]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "pattern": "^REQ-DEMO-[0-9]{3}$"
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "kind"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "adr_id",
          "title",
          "decision",
          "consequence",
          "requirement_ids"
        ],
        "properties": {
          "adr_id": {
            "type": "string",
            "pattern": "^ADR-DEMO-[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "consequence": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "pattern": "^REQ-DEMO-[0-9]{3}$"
            }
          }
        }
      }
    }
  }
}
