{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/demo/run-summary.schema.json",
  "title": "Synthetic demo run summary",
  "description": "Machine-readable summary of one synthetic two-gate (G2, G3) workflow demonstration run.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract",
    "contract_version",
    "environment",
    "demo_run_id",
    "started_at",
    "finished_at",
    "verdict",
    "production_authorization",
    "real_bmad_execution",
    "legacy_equivalence",
    "real_project_status",
    "steps",
    "baseline",
    "bmad",
    "limitations"
  ],
  "properties": {
    "contract": {
      "const": "demo/run-summary"
    },
    "contract_version": {
      "const": "1.0"
    },
    "environment": {
      "const": "SYNTHETIC_INTERVIEW_DEMO"
    },
    "demo_run_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "SYNTHETIC_DEMO_COMPLETED",
        "SYNTHETIC_DEMO_FAILED"
      ]
    },
    "production_authorization": {
      "const": "NOT_GRANTED"
    },
    "real_bmad_execution": {
      "const": "NOT_EXECUTED"
    },
    "legacy_equivalence": {
      "const": "NOT_ESTABLISHED"
    },
    "real_project_status": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "kind",
          "name",
          "demo_status",
          "reason",
          "result"
        ],
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "precheck",
              "gate",
              "automated"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "demo_status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN"
            ]
          },
          "reason": {
            "type": "string"
          },
          "result": {
            "type": [
              "string",
              "null"
            ]
          },
          "checks_passed": {
            "type": "integer"
          },
          "checks_total": {
            "type": "integer"
          }
        }
      }
    },
    "baseline": {
      "type": "object"
    },
    "bmad": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
