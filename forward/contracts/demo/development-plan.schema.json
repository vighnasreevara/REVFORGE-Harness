{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/demo/development-plan.schema.json",
  "title": "Synthetic demo development plan",
  "description": "Epics and stories for the synthetic demo program, bound to the exact requirements and architecture (demo step STORIES, an automated validation). Never Java generation authorisation for the real project.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "environment",
    "program_id",
    "requirements_ref",
    "architecture_ref",
    "java_generation_authorization",
    "epics",
    "stories"
  ],
  "properties": {
    "contract": {
      "const": "demo/development-plan"
    },
    "contract_version": {
      "const": "1.0"
    },
    "environment": {
      "const": "SYNTHETIC_INTERVIEW_DEMO"
    },
    "program_id": {
      "type": "string",
      "minLength": 1
    },
    "authored_by": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string"
    },
    "requirements_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "architecture_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "java_generation_authorization": {
      "const": "NOT_GRANTED"
    },
    "epics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "epic_id",
          "title",
          "story_ids"
        ],
        "properties": {
          "epic_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "story_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "story_id",
          "title",
          "requirement_ids",
          "component_ids",
          "tasks",
          "acceptance_criteria"
        ],
        "properties": {
          "story_id": {
            "type": "string",
            "pattern": "^ST-DEMO-[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^REQ-DEMO-[0-9]{3}$"
            }
          },
          "component_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^CMP-DEMO-[0-9]{2}$"
            }
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
