{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/demo/reverse-evidence.schema.json",
  "title": "Synthetic reverse-engineering evidence",
  "description": "Synthetic program, paragraph, statement, record, field and business-rule identities for the demo program. Never part of the real reverse artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "environment",
    "system_id",
    "file",
    "paragraphs",
    "statements",
    "records",
    "fields",
    "business_rules"
  ],
  "properties": {
    "contract": {
      "const": "demo/reverse-evidence"
    },
    "contract_version": {
      "const": "1.0"
    },
    "environment": {
      "const": "SYNTHETIC_INTERVIEW_DEMO"
    },
    "note": {
      "type": "string"
    },
    "system_id": {
      "const": "SYN-DEMO"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_id",
        "path_id",
        "path",
        "program_id",
        "sha256",
        "lines"
      ],
      "properties": {
        "file_id": {
          "type": "string",
          "pattern": "^SYN-DEMO-FIL-[0-9]{4}$"
        },
        "path_id": {
          "type": "string",
          "pattern": "^SYN-DEMO-PATH-[0-9]{4}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "program_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lines": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paragraph_id",
          "name",
          "first_line",
          "last_line"
        ],
        "properties": {
          "paragraph_id": {
            "type": "string",
            "pattern": "^SYN-DEMO-PAR-[0-9]{4}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "first_line": {
            "type": "integer"
          },
          "last_line": {
            "type": "integer"
          }
        }
      }
    },
    "statements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement_id",
          "paragraph_id",
          "line",
          "verb"
        ],
        "properties": {
          "statement_id": {
            "type": "string",
            "pattern": "^SYN-DEMO-STMT-[0-9]{4}$"
          },
          "paragraph_id": {
            "type": "string",
            "pattern": "^SYN-DEMO-PAR-[0-9]{4}$"
          },
          "line": {
            "type": "integer"
          },
          "verb": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "name",
          "section",
          "length"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^SYN-DEMO-REC-[0-9]{4}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "length": {
            "type": "integer"
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field_id",
          "record_id",
          "name",
          "level",
          "offset",
          "length",
          "kind",
          "line"
        ],
        "properties": {
          "field_id": {
            "type": "string",
            "pattern": "^SYN-DEMO-FLD-[0-9]{4}$"
          },
          "record_id": {
            "type": "string",
            "pattern": "^SYN-DEMO-REC-[0-9]{4}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "length": {
            "type": "integer"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "digits": {
            "type": [
              "integer",
              "null"
            ]
          },
          "occurs": {
            "type": [
              "integer",
              "null"
            ]
          },
          "line": {
            "type": "integer"
          },
          "conditions": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "business_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "name",
          "category",
          "paragraph_id",
          "source_lines",
          "statement_ids",
          "field_ids",
          "description",
          "confidence"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^DBR-[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "paragraph_id": {
            "type": "string",
            "pattern": "^SYN-DEMO-PAR-[0-9]{4}$"
          },
          "source_lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer"
            }
          },
          "statement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^SYN-DEMO-STMT-[0-9]{4}$"
            }
          },
          "field_ids": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "pattern": "^SYN-DEMO-FLD-[0-9]{4}$"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    }
  }
}
