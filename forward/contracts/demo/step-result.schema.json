{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/demo/step-result.schema.json",
  "title": "Synthetic demo step result",
  "description": "Result of one demo step (a pre-check, one of the human gates G1/G2, or an automated step). demo_status is evaluated from the listed checks; it is never a production gate status.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract",
    "contract_version",
    "environment",
    "demo_run_id",
    "step",
    "kind",
    "name",
    "demo_status",
    "reason",
    "prerequisite",
    "responsibility",
    "approval_evidence",
    "checks",
    "evidence",
    "evaluated_at",
    "production_authorization"
  ],
  "properties": {
    "contract": {
      "const": "demo/step-result"
    },
    "contract_version": {
      "const": "1.0"
    },
    "environment": {
      "const": "SYNTHETIC_INTERVIEW_DEMO"
    },
    "demo_run_id": {
      "type": "string",
      "minLength": 1
    },
    "step": {
      "enum": [
        "BASELINE",
        "EVIDENCE",
        "G1",
        "G2",
        "STORIES",
        "BUILD",
        "VERIFY",
        "REVIEW",
        "COMPLETE"
      ]
    },
    "kind": {
      "enum": [
        "precheck",
        "gate",
        "automated"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "demo_status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN"
      ]
    },
    "reason": {
      "type": "string"
    },
    "prerequisite": {
      "type": [
        "string",
        "null"
      ]
    },
    "responsibility": {
      "type": "string",
      "minLength": 1
    },
    "approval_evidence": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ok",
          "detail"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ok": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "production_authorization": {
      "const": "NOT_GRANTED"
    },
    "details": {
      "type": "object"
    }
  }
}
