{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/demo/data-contract.schema.json",
  "title": "Synthetic demo data contract",
  "description": "Interface record layout of the synthetic demo program (checked against the parsed COBOL at G1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "environment",
    "program_id",
    "interface",
    "record",
    "fields",
    "numeric_rules"
  ],
  "properties": {
    "contract": {
      "const": "demo/data-contract"
    },
    "contract_version": {
      "const": "1.0"
    },
    "environment": {
      "const": "SYNTHETIC_INTERVIEW_DEMO"
    },
    "program_id": {
      "type": "string",
      "minLength": 1
    },
    "interface": {
      "type": "string",
      "minLength": 1
    },
    "authored_by": {
      "type": "string",
      "minLength": 1
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "record_id",
        "length"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "length": {
          "type": "integer"
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "offset",
          "length",
          "picture",
          "direction",
          "java",
          "domain"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "offset": {
            "type": "integer"
          },
          "length": {
            "type": "integer"
          },
          "picture": {
            "type": "string",
            "minLength": 1
          },
          "occurs": {
            "type": "integer"
          },
          "stride": {
            "type": "integer"
          },
          "direction": {
            "enum": [
              "in",
              "out",
              "inout"
            ]
          },
          "java": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "numeric_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
