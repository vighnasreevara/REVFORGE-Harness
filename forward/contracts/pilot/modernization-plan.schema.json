{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/pilot/modernization-plan.schema.json",
  "title": "Source-backed modernization plan (non-authoritative)",
  "type": "object",
  "required": ["contract", "contract_version", "status", "scope", "baseline", "scope_sha256", "readiness", "open_decisions", "requirements", "counts"],
  "properties": {
    "contract": { "const": "pilot/modernization-plan" },
    "contract_version": { "const": "1.0" },
    "status": { "const": "NON_AUTHORITATIVE" },
    "scope": { "type": "string", "minLength": 1 },
    "scope_sha256": { "$ref": "../common.schema.json#/definitions/sha256" },
    "readiness": { "enum": ["READY", "NOT_READY"] },
    "baseline": {
      "type": "object",
      "required": ["run_id", "manifest_sha256"],
      "properties": { "manifest_sha256": { "$ref": "../common.schema.json#/definitions/sha256" } }
    },
    "open_decisions": {
      "type": "array",
      "items": { "type": "object", "required": ["decision_id", "kind", "roles", "unresolved_names"] }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "item_sha256", "support_class", "category", "g2", "evidence", "statements", "independent_portion", "dependent_portion", "required_human_decisions", "implementable_independently", "implied_tests"],
        "properties": {
          "support_class": { "enum": ["FULLY_SOURCE_SUPPORTED", "PARTIALLY_SUPPORTED", "DEPENDENT_ON_TECHNICAL_DECISION", "INSUFFICIENT_EVIDENCE", "CONTRADICTED"] },
          "category": { "enum": ["VERIFIED", "PARTIAL", "GAP"] },
          "item_sha256": { "$ref": "../common.schema.json#/definitions/sha256" },
          "g2": { "type": "object", "required": ["outcome", "blocking"] },
          "evidence": { "type": "object", "required": ["established", "by", "source_hashes"] }
        }
      }
    },
    "counts": { "type": "object", "required": ["by_class", "by_category"] }
  }
}
