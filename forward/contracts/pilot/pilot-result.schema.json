{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/pilot/pilot-result.schema.json",
  "title": "Conversion pilot result (synthetic pilot or authorised local generation)",
  "type": "object",
  "required": [
    "contract",
    "contract_version",
    "synthetic",
    "inputs",
    "stages",
    "isolation",
    "toolchain",
    "conversion_status"
  ],
  "properties": {
    "contract": {
      "const": "pilot/pilot-result"
    },
    "contract_version": {
      "const": "1.0"
    },
    "synthetic": {
      "type": "boolean"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "sha256": {
            "$ref": "../common.schema.json#/definitions/sha256"
          }
        }
      }
    },
    "isolation": {
      "type": "object",
      "required": [
        "workflow_used",
        "approvals_used",
        "production_generation",
        "external_ai_calls"
      ],
      "properties": {
        "workflow_used": {
          "type": "boolean"
        },
        "approvals_used": {
          "type": "boolean"
        },
        "production_generation": {
          "type": "boolean"
        },
        "external_ai_calls": {
          "const": false
        }
      }
    },
    "conversion_status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "FAILED",
        "NOT_EXECUTED"
      ]
    },
    "equivalence": {
      "enum": [
        "EQUIVALENT_ON_EXECUTED_FIXTURES",
        "EQUIVALENCE_UNVERIFIED"
      ]
    },
    "validation": {
      "type": "object",
      "required": [
        "kind",
        "statement"
      ],
      "properties": {
        "kind": {
          "enum": [
            "FIXTURE_BASED",
            "COBOL_REFERENCE_AND_FIXTURES"
          ]
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gap_id",
          "kind",
          "subject",
          "origin",
          "dependent_statements",
          "status"
        ],
        "properties": {
          "gap_id": {
            "type": "string",
            "pattern": "^GAP-[A-Z0-9-]+-[0-9]{4}$"
          },
          "status": {
            "const": "OPEN"
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "required": [
        "record_id",
        "policy",
        "program",
        "source_sha256",
        "output_dir",
        "accepted_by"
      ],
      "properties": {
        "policy": {
          "const": "program_scoped_local_v1"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "gaps": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": [
          "gaps"
        ]
      },
      "then": {
        "properties": {
          "conversion_status": {
            "not": {
              "const": "COMPLETE"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "validation": {
            "properties": {
              "kind": {
                "const": "FIXTURE_BASED"
              }
            }
          }
        },
        "required": [
          "validation"
        ]
      },
      "then": {
        "properties": {
          "equivalence": {
            "const": "EQUIVALENCE_UNVERIFIED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "synthetic": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "isolation": {
            "properties": {
              "workflow_used": {
                "const": false
              },
              "approvals_used": {
                "const": false
              },
              "production_generation": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "synthetic": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "authorization"
        ]
      }
    }
  ]
}
