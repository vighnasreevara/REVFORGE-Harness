{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/openai/pass-a-output.schema.json",
  "title": "Pass A independent source interpretation (model output)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "pass",
    "operations",
    "missing_dependencies",
    "cannot_establish",
    "untrusted_instructions_observed"
  ],
  "properties": {
    "packet_id": {
      "type": "string"
    },
    "pass": {
      "type": "string",
      "enum": [
        "A"
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "description",
          "conditions",
          "data_read",
          "data_modified",
          "calculation",
          "execution_effect",
          "citations"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "data_movement",
              "arithmetic",
              "condition",
              "control_transfer",
              "file_io",
              "database",
              "call",
              "error_handling",
              "declaration",
              "other"
            ]
          },
          "description": {
            "type": "string"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data_read": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data_modified": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "calculation": {
            "type": [
              "string",
              "null"
            ]
          },
          "execution_effect": {
            "type": [
              "string",
              "null"
            ]
          },
          "citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/citation"
            }
          }
        }
      }
    },
    "missing_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "reason",
          "citations"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "copybook",
              "program",
              "data_item",
              "paragraph",
              "runtime_service",
              "other"
            ]
          },
          "reason": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/citation"
            }
          }
        }
      }
    },
    "cannot_establish": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "untrusted_instructions_observed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "line_start",
        "line_end",
        "quoted_text",
        "permanent_id"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line_start": {
          "type": "integer"
        },
        "line_end": {
          "type": "integer"
        },
        "quoted_text": {
          "type": "string"
        },
        "permanent_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
