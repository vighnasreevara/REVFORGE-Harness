{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/verification/semantic-dependency.schema.json",
  "title": "Semantic dependency finding (SDF)",
  "type": "object",
  "required": ["contract", "contract_version", "finding_id", "item_id", "version", "supersedes", "recorded_at", "baseline_manifest_sha256", "item_sha256", "content_sha256", "result", "effect"],
  "properties": {
    "contract": { "const": "verification/semantic-dependency" },
    "contract_version": { "const": "1.0" },
    "finding_id": { "type": "string", "pattern": "^SDF-[0-9]{4}$" },
    "item_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "supersedes": { "type": ["string", "null"] },
    "baseline_manifest_sha256": { "$ref": "../common.schema.json#/definitions/sha256" },
    "item_sha256": { "$ref": "../common.schema.json#/definitions/sha256" },
    "content_sha256": { "$ref": "../common.schema.json#/definitions/sha256" },
    "result": {
      "type": "object",
      "required": ["item_id", "item_kind", "edges", "finding"],
      "properties": {
        "finding": { "const": "SEMANTIC_DEPENDENCY_ON_OPEN_DECISION" },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object", "required": ["decision_id", "names", "statements"], "properties": { "names": { "type": "array", "minItems": 1 } } }
        }
      }
    }
  }
}
