{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/verification/evidence-supplement.schema.json",
  "title": "Versioned, immutable source-context evidence supplement (never effective until a signed resolution selects it)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "supplement_id",
    "item_id",
    "item_kind",
    "item_sha256",
    "version",
    "supersedes",
    "recorded_at",
    "baseline_manifest_sha256",
    "method",
    "result",
    "acceptance",
    "effect"
  ],
  "properties": {
    "contract": {
      "const": "verification/evidence-supplement"
    },
    "contract_version": {
      "const": "1.0"
    },
    "supplement_id": {
      "type": "string",
      "pattern": "^ESU-[0-9]{4}$"
    },
    "item_id": {
      "type": "string"
    },
    "item_kind": {
      "type": "string"
    },
    "item_sha256": {
      "$ref": "../common.schema.json#/definitions/sha256"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ESU-[0-9]{4}$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "baseline_manifest_sha256": {
      "$ref": "../common.schema.json#/definitions/sha256"
    },
    "method": {
      "type": "string",
      "minLength": 20
    },
    "result": {
      "type": "object",
      "required": [
        "item_id",
        "kind",
        "item_sha256",
        "claim",
        "claimed_literals",
        "existing",
        "refs",
        "levels",
        "status",
        "literal_support",
        "additional_references",
        "contradictions",
        "metadata_disagreements",
        "uncertainties",
        "source_hashes",
        "human_decision_needed",
        "result_sha256"
      ],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "item_sha256": {
          "$ref": "../common.schema.json#/definitions/sha256"
        },
        "status": {
          "enum": [
            "CONTEXT_SUPPORTED",
            "CONTEXT_PARTIAL",
            "CONTEXT_UNSUPPORTED",
            "CONTEXT_UNRESOLVED",
            "CONTEXT_CONTRADICTED",
            "CITATION_MISMATCH",
            "SOURCE_UNAVAILABLE",
            "NOT_APPLICABLE"
          ]
        },
        "result_sha256": {
          "$ref": "../common.schema.json#/definitions/sha256"
        },
        "levels": {
          "type": "object",
          "required": [
            "symbol_exists",
            "symbol_resolved",
            "value_declared",
            "statement_references",
            "runtime_effect_supported",
            "business_interpretation"
          ],
          "properties": {
            "business_interpretation": {
              "const": "not_established_requires_human"
            }
          }
        },
        "human_decision_needed": {
          "type": "object",
          "required": [
            "needed",
            "why"
          ],
          "properties": {
            "needed": {
              "const": true
            }
          }
        },
        "source_hashes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ]
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "required",
        "how",
        "eligible"
      ],
      "properties": {
        "decision_id": {
          "type": "string"
        },
        "required": {
          "const": true
        },
        "how": {
          "type": "string"
        },
        "eligible": {
          "type": "boolean"
        }
      }
    },
    "effect": {
      "type": "string",
      "minLength": 20
    }
  }
}
