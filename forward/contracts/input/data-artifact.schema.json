{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/input/data-artifact.schema.json",
  "title": "Reverse Agent 3 data_artifact.json (consumed core)",
  "type": "object",
  "required": ["meta", "record_catalogue", "field_catalogue", "condition_catalogue", "data_model"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["agent_version", "system_id"],
      "properties": {
        "agent_version": { "type": "string" },
        "system_id": { "$ref": "../common.schema.json#/definitions/systemId" },
        "data_run_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "record_catalogue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["record_id", "file_id", "record_name"],
        "properties": {
          "record_id": { "$ref": "../common.schema.json#/definitions/recordId" },
          "file_id": { "$ref": "../common.schema.json#/definitions/fileId" },
          "record_name": { "type": "string" },
          "source_type": { "type": ["string", "null"] },
          "used_by_programs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "field_catalogue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["record_id", "field_name"],
        "properties": {
          "field_id": { "anyOf": [{ "$ref": "../common.schema.json#/definitions/fieldId" }, { "type": "null" }] },
          "record_id": { "$ref": "../common.schema.json#/definitions/recordId" },
          "field_name": { "type": "string" }
        }
      }
    },
    "condition_catalogue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["condition_id", "condition_name"],
        "properties": {
          "condition_id": { "$ref": "../common.schema.json#/definitions/fieldId" },
          "parent_record_id": { "anyOf": [{ "$ref": "../common.schema.json#/definitions/recordId" }, { "type": "null" }] }
        }
      }
    },
    "data_model": {
      "type": "object",
      "required": ["entities", "relationships"],
      "properties": {
        "entities": { "type": "array" },
        "relationships": { "type": "array" }
      }
    },
    "issues": { "type": "array" }
  }
}
