{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/orchestrator/workflow-state.schema.json",
  "title": "Forward workflow state and checkpoint",
  "type": "object",
  "required": ["contract", "workflow_id", "run_id", "baseline", "state", "blocked_from", "blockers", "history", "gates", "packets", "receipts", "checkpoint"],
  "properties": {
    "contract": { "const": "workflow-state" },
    "state": {
      "enum": ["INITIALIZED", "BASELINE_LOADED", "EVIDENCE_VALIDATED", "REQUIREMENTS_DRAFTED", "REQUIREMENTS_APPROVED", "ARCHITECTURE_DRAFTED", "ARCHITECTURE_APPROVED", "STORIES_DRAFTED", "IMPLEMENTING", "IMPLEMENTATION_BUILT", "TESTING", "REVIEWING", "COMPLETED", "BLOCKED", "FAILED"]
    },
    "baseline": {
      "type": "object",
      "required": ["run_id", "manifest_sha256", "inputs"],
      "properties": { "manifest_sha256": { "$ref": "../common.schema.json#/definitions/sha256" } }
    },
    "history": {
      "type": "array",
      "items": { "type": "object", "required": ["seq", "at", "from", "to", "guard"] }
    },
    "prechecks": {
      "description": "BASELINE and EVIDENCE pre-check results; absent in runs created before the two-gate change, which recorded them as gates G0 and G1.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "result_file", "evaluated_at", "baseline_sha256"],
        "properties": { "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "UNVERIFIED"] } }
      }
    },
    "gate_scheme": {
      "description": "Gate numbering of this state's records. 2 (every workflow created since 2026-11-09): gates are keyed G1 (approved requirements) and G2 (approved architecture). Absent: a legacy state keyed by the former IDs G2 (requirements) and G3 (architecture), possibly with G0/G1 results of the former BASELINE/EVIDENCE gates; such records are read through the runtime's gate-key mapping and never rewritten.",
      "const": 2
    },
    "gates": {
      "description": "Latest result per gate, keyed by gate ID in the state's gate_scheme (see gate_scheme).",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "result_file", "evaluated_at", "baseline_sha256"],
        "properties": { "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "UNVERIFIED"] } }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["seq", "at", "state_sha256", "audit_head", "audit_entries"],
      "properties": { "state_sha256": { "$ref": "../common.schema.json#/definitions/sha256" } }
    }
  }
}
