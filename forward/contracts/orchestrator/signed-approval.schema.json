{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/orchestrator/signed-approval.schema.json",
  "title": "Signed G1 approval (produced by a human outside the harness)",
  "description": "statement is signed with the signer's Ed25519 private key; the signed message is the UTF-8 canonical JSON of statement (keys sorted, no whitespace). Print it with 'workflow approval statement'.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "statement",
    "signature"
  ],
  "properties": {
    "contract": {
      "const": "signed-approval"
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "statement_version",
        "gate",
        "request_id",
        "request_sha256",
        "scope_sha256",
        "baseline_manifest_sha256",
        "decision",
        "signer_id",
        "role"
      ],
      "properties": {
        "contract": {
          "const": "approval-statement"
        },
        "statement_version": {
          "const": "1.0"
        },
        "gate": {
          "description": "G1 (approved requirements). G2 is accepted only when re-verifying statements signed before the 2026-11-09 gate renumbering, when the requirements gate was G2; the runtime accepts it for legacy workflow states only and requires it to match the request's gate.",
          "enum": ["G1", "G2"]
        },
        "request_id": {
          "type": "string",
          "pattern": "^AREQ-[0-9]{4}$"
        },
        "request_sha256": {
          "$ref": "../common.schema.json#/definitions/sha256"
        },
        "scope_sha256": {
          "$ref": "../common.schema.json#/definitions/sha256"
        },
        "baseline_manifest_sha256": {
          "$ref": "../common.schema.json#/definitions/sha256"
        },
        "decision": {
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "signer_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._@-]{2,128}$"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "comment": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/=]{80,100}$",
          "description": "Base64 Ed25519 signature over the UTF-8 canonical JSON of the signed object"
        }
      }
    }
  }
}
