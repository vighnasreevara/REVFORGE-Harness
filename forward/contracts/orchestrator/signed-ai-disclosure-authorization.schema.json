{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/orchestrator/signed-ai-disclosure-authorization.schema.json",
  "title": "Signed AI disclosure authorization (Ed25519 over the canonical authorization)",
  "type": "object",
  "properties": {
    "contract": {
      "const": "signed-ai-disclosure-authorization"
    },
    "authorization": {
      "$ref": "ai-disclosure-authorization.schema.json"
    },
    "signature": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/=]{80,100}$"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract",
    "authorization",
    "signature"
  ],
  "additionalProperties": false
}
