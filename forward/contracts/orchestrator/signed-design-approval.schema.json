{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/orchestrator/signed-design-approval.schema.json",
  "title": "Signed G3 architecture approval statement (Ed25519 over its canonical JSON)",
  "type": "object",
  "properties": {
    "contract": {
      "const": "signed-design-approval"
    },
    "statement": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "design-approval-statement"
        },
        "statement_version": {
          "const": "1.0"
        },
        "gate": {
          "enum": [
            "G3"
          ]
        },
        "request_id": {
          "type": "string",
          "pattern": "^DREQ-[0-9]{4}$"
        },
        "request_sha256": {
          "$ref": "../common.schema.json#/definitions/sha256"
        },
        "scope_sha256": {
          "$ref": "../common.schema.json#/definitions/sha256"
        },
        "requirements_sha256": {
          "$ref": "../common.schema.json#/definitions/sha256"
        },
        "artifact_sha256": {
          "$ref": "../common.schema.json#/definitions/sha256"
        },
        "dependency_sha256": {
          "$ref": "../common.schema.json#/definitions/sha256"
        },
        "upstream_approval_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "baseline_manifest_sha256": {
          "$ref": "../common.schema.json#/definitions/sha256"
        },
        "decision": {
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "signer_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "signed_at": {
          "$ref": "../common.schema.json#/definitions/isoTimestamp"
        },
        "comment": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "contract",
        "statement_version",
        "gate",
        "request_id",
        "request_sha256",
        "scope_sha256",
        "requirements_sha256",
        "artifact_sha256",
        "dependency_sha256",
        "upstream_approval_ids",
        "baseline_manifest_sha256",
        "decision",
        "signer_id",
        "role",
        "signed_at"
      ],
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/=]{80,100}$"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract",
    "statement",
    "signature"
  ],
  "additionalProperties": false
}
