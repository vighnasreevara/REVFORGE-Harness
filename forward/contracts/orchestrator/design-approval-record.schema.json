{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/orchestrator/design-approval-record.schema.json",
  "title": "Runtime record of an imported, verified G3 architecture approval",
  "type": "object",
  "properties": {
    "contract": {
      "const": "design-approval-record"
    },
    "contract_version": {
      "const": "1.0"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^DAP-[0-9]{4}$"
    },
    "gate": {
      "enum": [
        "G3"
      ]
    },
    "decision": {
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "recorded_at": {
      "$ref": "../common.schema.json#/definitions/isoTimestamp"
    },
    "recorded_by": {
      "const": "runtime"
    },
    "request_id": {
      "type": "string",
      "pattern": "^DREQ-[0-9]{4}$"
    },
    "request_sha256": {
      "$ref": "../common.schema.json#/definitions/sha256"
    },
    "scope": {
      "type": "object",
      "properties": {
        "selector_text": {
          "type": "string",
          "minLength": 1
        },
        "scope_sha256": {
          "$ref": "../common.schema.json#/definitions/sha256"
        }
      },
      "required": [
        "selector_text",
        "scope_sha256"
      ],
      "additionalProperties": false
    },
    "requirements_sha256": {
      "$ref": "../common.schema.json#/definitions/sha256"
    },
    "artifact_sha256": {
      "$ref": "../common.schema.json#/definitions/sha256"
    },
    "dependency_sha256": {
      "$ref": "../common.schema.json#/definitions/sha256"
    },
    "upstream_approval_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "baseline_manifest_sha256": {
      "$ref": "../common.schema.json#/definitions/sha256"
    },
    "signer": {
      "type": "object",
      "properties": {
        "signer_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "key_fingerprint": {
          "$ref": "../common.schema.json#/definitions/sha256"
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "signer_id",
        "role",
        "key_fingerprint",
        "display_name"
      ],
      "additionalProperties": false
    },
    "trust_store_sha256": {
      "$ref": "../common.schema.json#/definitions/sha256"
    },
    "statement": {
      "type": "object"
    },
    "signature": {
      "type": "object"
    },
    "verification": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "ok": {
                "type": "boolean"
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "ok",
              "detail"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "checks"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract",
    "contract_version",
    "approval_id",
    "gate",
    "decision",
    "recorded_at",
    "recorded_by",
    "request_id",
    "request_sha256",
    "scope",
    "requirements_sha256",
    "artifact_sha256",
    "dependency_sha256",
    "upstream_approval_ids",
    "baseline_manifest_sha256",
    "signer",
    "trust_store_sha256",
    "statement",
    "signature",
    "verification"
  ],
  "additionalProperties": false
}
