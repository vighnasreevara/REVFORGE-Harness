{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/orchestrator/precheck-result.schema.json",
  "title": "Pre-check result (BASELINE or EVIDENCE), written by the runtime",
  "description": "The automated checks that guard the start of the workflow and gate G1. They were recorded as gates G0 and G1 before the two-gate change; those older records are read, never rewritten.",
  "type": "object",
  "required": ["contract", "check", "name", "status", "reason", "evaluated_at", "baseline", "inputs", "checks", "limitations"],
  "properties": {
    "contract": { "const": "precheck-result" },
    "check": { "enum": ["BASELINE", "EVIDENCE"] },
    "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "UNVERIFIED"] },
    "reason": { "type": "string", "minLength": 1 },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "baseline": {
      "type": "object",
      "required": ["run_id", "manifest_sha256"],
      "properties": { "manifest_sha256": { "$ref": "../common.schema.json#/definitions/sha256" } }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "required": ["kind", "ref", "sha256"] }
    },
    "checks": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "status", "detail"], "properties": { "status": { "enum": ["pass", "fail", "warn", "info"] } } }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PASS" } } },
      "then": { "properties": { "checks": { "minItems": 1, "items": { "properties": { "status": { "not": { "const": "fail" } } } } } } }
    }
  ]
}
