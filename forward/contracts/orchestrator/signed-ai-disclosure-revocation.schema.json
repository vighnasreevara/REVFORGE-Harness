{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/orchestrator/signed-ai-disclosure-revocation.schema.json",
  "title": "Signed revocation of an AI disclosure authorization",
  "type": "object",
  "properties": {
    "contract": {
      "const": "signed-ai-disclosure-revocation"
    },
    "revocation": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "ai-disclosure-revocation"
        },
        "authorization_id": {
          "type": "string",
          "pattern": "^ADA-[0-9a-f]{12}$"
        },
        "reason": {
          "type": "string",
          "minLength": 10
        },
        "revoked_at": {
          "type": "string",
          "format": "date-time"
        },
        "signer_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "contract",
        "authorization_id",
        "reason",
        "revoked_at",
        "signer_id",
        "role"
      ],
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/=]{80,100}$"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract",
    "revocation",
    "signature"
  ],
  "additionalProperties": false
}
