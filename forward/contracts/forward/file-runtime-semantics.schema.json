{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/forward/file-runtime-semantics.schema.json",
  "title": "File operations and legacy runtime semantics (F2, fe-cobol-runtime-file-semantics)",
  "allOf": [{ "$ref": "forward-common.schema.json#/definitions/header" }],
  "type": "object",
  "required": ["contract", "programs"],
  "properties": {
    "contract": { "const": "forward/file-runtime-semantics" },
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit", "execution_model", "execution_model_evidence", "files", "return_code_behavior", "call_dependencies", "jcl", "compatibility_requirements", "unresolved_questions"],
        "properties": {
          "unit": { "$ref": "forward-common.schema.json#/definitions/unit" },
          "execution_model": { "enum": ["batch_main", "batch_subprogram", "callable_service", "online_cics_transaction", "online_cics_subprogram", "template", "utility", "test_tool", "empty", "unknown"] },
          "execution_model_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_status", "basis", "source_refs"],
            "properties": {
              "evidence_status": { "$ref": "forward-common.schema.json#/definitions/evidenceStatus" },
              "basis": { "type": "string", "minLength": 3 },
              "source_refs": { "type": "array", "items": { "$ref": "forward-common.schema.json#/definitions/sourceRef" } }
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["select_name", "assign_to", "organization", "access_mode", "record_key", "file_status_field", "operations", "status_codes_handled", "evidence_status"],
              "properties": {
                "select_name": { "type": "string" },
                "assign_to": { "type": ["string", "null"] },
                "organization": { "enum": ["sequential", "line_sequential", "relative", "indexed", "unknown"] },
                "access_mode": { "enum": ["sequential", "random", "dynamic", "unknown"] },
                "record_key": { "type": ["string", "null"] },
                "file_status_field": { "type": ["string", "null"] },
                "record_ids": { "type": "array", "items": { "$ref": "../common.schema.json#/definitions/recordId" } },
                "operations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["verb", "statement_id", "paragraph_id", "evidence_status"],
                    "properties": {
                      "verb": { "enum": ["OPEN", "READ", "WRITE", "REWRITE", "DELETE", "START", "CLOSE"] },
                      "mode": { "type": ["string", "null"] },
                      "statement_id": { "anyOf": [{ "$ref": "../common.schema.json#/definitions/statementId" }, { "type": "null" }] },
                      "paragraph_id": { "anyOf": [{ "$ref": "../common.schema.json#/definitions/paragraphId" }, { "type": "null" }] },
                      "evidence_status": { "$ref": "forward-common.schema.json#/definitions/evidenceStatus" }
                    }
                  }
                },
                "status_codes_handled": { "type": "array", "items": { "type": "string" } },
                "evidence_status": { "$ref": "forward-common.schema.json#/definitions/evidenceStatus" }
              }
            }
          },
          "db2": {
            "type": ["object", "null"],
            "properties": {
              "statements": { "type": "array", "items": { "type": "object" } },
              "sqlcode_handling": { "type": "string" },
              "commit_rollback": { "type": "string" },
              "evidence_status": { "$ref": "forward-common.schema.json#/definitions/evidenceStatus" }
            }
          },
          "cics": {
            "type": ["object", "null"],
            "properties": {
              "commands": { "type": "array", "items": { "type": "object" } },
              "commarea": { "type": ["string", "null"] },
              "handle_conditions": { "type": "array", "items": { "type": "object" } },
              "evidence_status": { "$ref": "forward-common.schema.json#/definitions/evidenceStatus" }
            }
          },
          "return_code_behavior": { "type": "string" },
          "checkpoint_restart": { "type": ["string", "null"] },
          "call_dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["target", "type", "resolved"],
              "properties": {
                "target": { "type": "string" },
                "type": { "type": "string" },
                "resolved": { "type": "boolean" },
                "target_file_id": { "$ref": "../common.schema.json#/definitions/nullableFileId" },
                "statement_id": { "anyOf": [{ "$ref": "../common.schema.json#/definitions/statementId" }, { "type": "null" }] }
              }
            }
          },
          "jcl": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["job_name", "file_id", "step"],
              "properties": {
                "job_name": { "type": "string" },
                "file_id": { "$ref": "../common.schema.json#/definitions/nullableFileId" },
                "step": { "type": ["string", "null"] }
              }
            }
          },
          "compatibility_requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["statement", "evidence_status", "source_refs"],
              "properties": {
                "statement": { "type": "string", "minLength": 5 },
                "evidence_status": { "$ref": "forward-common.schema.json#/definitions/evidenceStatus" },
                "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "forward-common.schema.json#/definitions/sourceRef" } }
              }
            }
          },
          "unresolved_questions": { "type": "array", "items": { "$ref": "forward-common.schema.json#/definitions/finding" } }
        }
      }
    }
  }
}
