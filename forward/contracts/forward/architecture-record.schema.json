{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/forward/architecture-record.schema.json",
  "title": "Java architecture record: components and ADRs (F3, fe-java-architecture-spine / fe-legacy-compatibility-adr)",
  "allOf": [
    {
      "$ref": "forward-common.schema.json#/definitions/header"
    }
  ],
  "type": "object",
  "required": [
    "contract",
    "record_type",
    "technical_baseline",
    "approved_inputs",
    "components",
    "adrs"
  ],
  "properties": {
    "contract": {
      "const": "forward/architecture-record"
    },
    "record_type": {
      "enum": [
        "component_design",
        "architecture_decisions"
      ]
    },
    "technical_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "java_version",
        "build_tool",
        "frameworks"
      ],
      "properties": {
        "java_version": {
          "type": "string",
          "pattern": "^21$"
        },
        "build_tool": {
          "const": "maven"
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "adr_id"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "adr_id": {
                "type": "string",
                "pattern": "^ADR-[0-9]{3}$"
              }
            }
          }
        }
      }
    },
    "approved_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements_approval",
        "data_contract_receipts"
      ],
      "properties": {
        "requirements_approval": {
          "type": "string",
          "minLength": 1
        },
        "data_contract_receipts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "requirements_approval names the signed G1 approval (APR-NNNN) of the exact scope the architecture is designed for."
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_id",
          "name",
          "kind",
          "responsibility",
          "replaces_units",
          "requirement_ids",
          "interfaces",
          "depends_on"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "pattern": "^CMP-[A-Z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "batch_job",
              "online_transaction",
              "shared_service",
              "data_access",
              "file_codec",
              "integration_boundary",
              "error_handling",
              "library"
            ]
          },
          "responsibility": {
            "type": "string"
          },
          "replaces_units": {
            "type": "array",
            "items": {
              "$ref": "forward-common.schema.json#/definitions/unit"
            }
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "forward-common.schema.json#/definitions/requirementId"
            }
          },
          "interfaces": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "contract"
              ]
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^CMP-[A-Z0-9-]+$"
            }
          }
        }
      }
    },
    "adrs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "adr_id",
          "title",
          "status",
          "existing_cobol_behavior",
          "proposed_java_behavior",
          "behavior_change",
          "source_refs",
          "compatibility_risks",
          "alternatives",
          "required_approvals",
          "testing_implications"
        ],
        "properties": {
          "adr_id": {
            "type": "string",
            "pattern": "^ADR-[0-9]{3}$"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "proposed"
            ]
          },
          "existing_cobol_behavior": {
            "type": "string",
            "minLength": 5
          },
          "proposed_java_behavior": {
            "type": "string",
            "minLength": 5
          },
          "behavior_change": {
            "type": "boolean"
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "forward-common.schema.json#/definitions/sourceRef"
            }
          },
          "compatibility_risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "alternatives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "required_approvals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "architecture_owner",
                "business_sme",
                "operations"
              ]
            }
          },
          "testing_implications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "compatibility_concerns": {
      "description": "Explicit treatment of each legacy compatibility concern. G2 derives which concerns apply to the approved scope from source facts and requires every applicable one to be addressed by an ADR or deferred to a resolved decision.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concern",
          "treatment",
          "adr_ids",
          "decision_id",
          "requirement_ids",
          "runtime_requirement_ids",
          "justification"
        ],
        "properties": {
          "concern": {
            "enum": [
              "decimal_precision",
              "batch_execution",
              "file_organization",
              "record_layouts",
              "return_codes",
              "jcl_dependencies",
              "db2_transactions",
              "cics_interfaces",
              "checkpoint_restart",
              "shared_dependencies"
            ]
          },
          "treatment": {
            "enum": [
              "addressed_by_adr",
              "deferred_to_decision",
              "not_applicable"
            ]
          },
          "adr_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ADR-[0-9]{3}$"
            }
          },
          "decision_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "$ref": "forward-common.schema.json#/definitions/requirementId"
            }
          },
          "runtime_requirement_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "justification": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "assumptions": {
      "description": "Architectural assumptions. A material assumption must be backed by a resolved decision; G2 rejects unbacked material assumptions.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assumption_id",
          "text",
          "material",
          "decision_id"
        ],
        "properties": {
          "assumption_id": {
            "type": "string",
            "pattern": "^ASM-[A-Z0-9-]+$"
          },
          "text": {
            "type": "string",
            "minLength": 5
          },
          "material": {
            "type": "boolean"
          },
          "decision_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
