{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/forward/test-fixture-manifest.schema.json",
  "title": "Independent test fixture manifest (F6, fe-independent-fixture-design)",
  "allOf": [{ "$ref": "forward-common.schema.json#/definitions/header" }],
  "type": "object",
  "required": ["contract", "fixtures"],
  "properties": {
    "contract": { "const": "forward/test-fixture-manifest" },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_id", "category", "requirement_ids", "source_refs", "input_description", "expected_result", "expected_result_basis", "derived_from_java"],
        "properties": {
          "fixture_id": { "type": "string", "pattern": "^FIX-[0-9]{3,}$" },
          "category": { "enum": ["normal", "boundary", "invalid_data", "numeric_precision", "rounding", "file_behavior", "error_case", "return_code", "restart_checkpoint", "online_interaction"] },
          "requirement_ids": { "type": "array", "minItems": 1, "items": { "$ref": "forward-common.schema.json#/definitions/requirementId" } },
          "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "forward-common.schema.json#/definitions/sourceRef" } },
          "input_description": { "type": "string" },
          "expected_result": { "type": "string" },
          "expected_result_basis": { "enum": ["source_semantics", "approved_requirement", "captured_cobol_reference"] },
          "derived_from_java": { "const": false }
        }
      }
    }
  }
}
