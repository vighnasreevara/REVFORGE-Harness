{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://revforge.local/contracts/forward/development-stories.schema.json",
  "title": "Epics, stories and sprint readiness (F4, fe-evidence-backed-stories / fe-sprint-readiness)",
  "allOf": [
    {
      "$ref": "forward-common.schema.json#/definitions/header"
    }
  ],
  "type": "object",
  "required": [
    "contract",
    "approval_baseline",
    "epics",
    "stories"
  ],
  "properties": {
    "contract": {
      "const": "forward/development-stories"
    },
    "approval_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements_gate_result",
        "architecture_gate_result"
      ],
      "properties": {
        "requirements_gate_result": {
          "type": "string"
        },
        "architecture_gate_result": {
          "type": "string"
        }
      },
      "description": "requirements_gate_result names the signed G2 approval (APR-NNNN) and architecture_gate_result the signed G3 approval (DAP-NNNN) the stories are planned against; G4 re-verifies both."
    },
    "epics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "epic_id",
          "title",
          "component_ids",
          "story_ids"
        ],
        "properties": {
          "epic_id": {
            "type": "string",
            "pattern": "^EPIC-[0-9]{3}$"
          },
          "title": {
            "type": "string"
          },
          "component_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "story_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^STORY-[0-9]{3}$"
            }
          }
        }
      }
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "story_id",
          "title",
          "requirement_ids",
          "component_ids",
          "source_refs",
          "implementation_scope",
          "dependencies",
          "data_contracts",
          "acceptance_criteria",
          "testing_expectations",
          "blocking_decisions",
          "readiness"
        ],
        "properties": {
          "story_id": {
            "type": "string",
            "pattern": "^STORY-[0-9]{3}$"
          },
          "title": {
            "type": "string"
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "forward-common.schema.json#/definitions/requirementId"
            }
          },
          "component_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "forward-common.schema.json#/definitions/sourceRef"
            }
          },
          "implementation_scope": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data_contracts": {
            "type": "array",
            "items": {
              "$ref": "../common.schema.json#/definitions/recordId"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "criterion",
                "verifies_source"
              ],
              "properties": {
                "criterion": {
                  "type": "string",
                  "minLength": 5
                },
                "verifies_source": {
                  "$ref": "forward-common.schema.json#/definitions/sourceRef"
                }
              }
            }
          },
          "testing_expectations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocking_decisions": {
            "type": "array",
            "items": {
              "$ref": "forward-common.schema.json#/definitions/decisionRequestId"
            }
          },
          "readiness": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "unmet"
            ],
            "properties": {
              "status": {
                "enum": [
                  "ready",
                  "blocked",
                  "unverified"
                ]
              },
              "unmet": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
